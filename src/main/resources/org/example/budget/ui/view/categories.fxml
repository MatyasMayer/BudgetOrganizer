<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.budget.ui.CategoriesController" spacing="12">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="%screen.categories" styleClass="title-2"/>

    <HBox spacing="24" VBox.vgrow="ALWAYS">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="%categories.expense" styleClass="title-4"/>
            <ListView fx:id="expenseList" VBox.vgrow="ALWAYS"/>
            <HBox spacing="8">
                <Button text="%categories.add" onAction="#addExpenseCategory"/>
                <Button fx:id="renameExpense" text="%categories.rename" onAction="#renameExpenseCategory"/>
                <Button fx:id="deleteExpense" text="%categories.delete" onAction="#deleteExpenseCategory"
                        styleClass="danger"/>
            </HBox>

            <Label text="%categories.limits" styleClass="title-4">
                <VBox.margin><Insets top="8"/></VBox.margin>
            </Label>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="‹" onAction="#previousLimitMonth" accessibleText="%categories.limits.month.previous">
                    <tooltip><Tooltip text="%categories.limits.month.previous"/></tooltip>
                </Button>
                <Label fx:id="limitMonthTitle" minWidth="150" alignment="CENTER"/>
                <Button text="›" onAction="#nextLimitMonth" accessibleText="%categories.limits.month.next">
                    <tooltip><Tooltip text="%categories.limits.month.next"/></tooltip>
                </Button>
            </HBox>
            <Label fx:id="limitsHint" text="%categories.limits.choose" styleClass="text-muted" wrapText="true"/>
            <GridPane fx:id="limitsGrid" hgap="8" vgap="6">
                <Label text="%categories.limits.default" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="defaultLimit" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Button text="%categories.limits.set" onAction="#setDefaultLimit"
                        GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <Button fx:id="clearDefault" text="%categories.limits.clear" onAction="#clearDefaultLimit"
                        GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                <Label fx:id="overrideTitle" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="limitOverride" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Button text="%categories.limits.set" onAction="#setLimitOverride"
                        GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Button fx:id="clearOverride" text="%categories.limits.clear" onAction="#clearLimitOverride"
                        GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                <Label fx:id="effectiveLimit" styleClass="text-bold"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4"/>
            </GridPane>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="%categories.income" styleClass="title-4"/>
            <ListView fx:id="incomeList" VBox.vgrow="ALWAYS"/>
            <HBox spacing="8">
                <Button text="%categories.add" onAction="#addIncomeCategory"/>
                <Button fx:id="renameIncome" text="%categories.rename" onAction="#renameIncomeCategory"/>
                <Button fx:id="deleteIncome" text="%categories.delete" onAction="#deleteIncomeCategory"
                        styleClass="danger"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
