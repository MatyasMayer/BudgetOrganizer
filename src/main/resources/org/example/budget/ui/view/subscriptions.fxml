<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.budget.ui.SubscriptionsController" spacing="12">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="%screen.subscriptions" styleClass="title-2"/>
    <Label fx:id="headline" styleClass="title-3"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="%subscriptions.empty" styleClass="text-muted"/></placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="%subscriptions.column.name" prefWidth="260"/>
            <TableColumn fx:id="categoryColumn" text="%subscriptions.column.category" prefWidth="160"/>
            <TableColumn fx:id="monthlyColumn" text="%subscriptions.column.monthly" prefWidth="140"
                         style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="yearlyColumn" text="%subscriptions.column.yearly" prefWidth="140"
                         style="-fx-alignment: CENTER-RIGHT;"/>
        </columns>
    </TableView>

    <Label fx:id="totals" styleClass="title-4"/>
    <Label fx:id="unpriced" styleClass="text-muted" wrapText="true"/>
</VBox>
