<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.budget.ui.YearController" fitToWidth="true"
            styleClass="edge-to-edge" stylesheets="@year.css">
    <VBox spacing="16">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

        <Label text="%screen.year" styleClass="title-2"/>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="‹" onAction="#previousYear" accessibleText="%year.previous">
                <tooltip><Tooltip text="%year.previous"/></tooltip>
            </Button>
            <Label fx:id="yearTitle" styleClass="title-3" minWidth="100" alignment="CENTER"/>
            <Button text="›" onAction="#nextYear" accessibleText="%year.next">
                <tooltip><Tooltip text="%year.next"/></tooltip>
            </Button>
            <Button text="%year.current" onAction="#currentYear"/>
        </HBox>

        <VBox fx:id="content" spacing="16"/>
    </VBox>
</ScrollPane>
