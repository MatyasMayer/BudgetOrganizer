<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.budget.ui.RecurringController" spacing="12">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="%screen.recurring" styleClass="title-2"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%recurring.new" onAction="#newTemplate" defaultButton="true"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="%recurring.empty" styleClass="text-muted"/></placeholder>
        <columns>
            <TableColumn fx:id="typeColumn" text="%recurring.column.type" prefWidth="80"/>
            <TableColumn fx:id="categoryColumn" text="%recurring.column.category" prefWidth="130"/>
            <TableColumn fx:id="amountColumn" text="%recurring.column.amount" prefWidth="120"
                         style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="repeatsColumn" text="%recurring.column.repeats" prefWidth="150"/>
            <TableColumn fx:id="startColumn" text="%recurring.column.start" prefWidth="100"/>
            <TableColumn fx:id="endColumn" text="%recurring.column.end" prefWidth="100"/>
            <TableColumn fx:id="noteColumn" text="%recurring.column.note" prefWidth="200"/>
        </columns>
    </TableView>

    <Label fx:id="summary" styleClass="text-muted"/>
</VBox>
