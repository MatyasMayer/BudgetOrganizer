<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.budget.ui.TransactionsController" spacing="12">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="%screen.transactions" styleClass="title-2"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%transactions.new" onAction="#newTransaction" defaultButton="true"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="monthFilter" promptText="%transactions.filter.month"/>
        <ComboBox fx:id="typeFilter" promptText="%transactions.filter.type"/>
        <ComboBox fx:id="categoryFilter" promptText="%transactions.filter.category"/>
        <TextField fx:id="noteSearch" promptText="%transactions.search.prompt" HBox.hgrow="ALWAYS"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="%transactions.empty" styleClass="text-muted"/></placeholder>
        <columns>
            <TableColumn fx:id="dateColumn" text="%transactions.column.date" prefWidth="110"/>
            <TableColumn fx:id="typeColumn" text="%transactions.column.type" prefWidth="90"/>
            <TableColumn fx:id="categoryColumn" text="%transactions.column.category" prefWidth="150"/>
            <TableColumn fx:id="amountColumn" text="%transactions.column.amount" prefWidth="140"
                         style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="originalColumn" text="%transactions.column.original" prefWidth="130"
                         style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="noteColumn" text="%transactions.column.note" prefWidth="300"/>
        </columns>
    </TableView>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="summary" styleClass="text-muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <MenuButton text="%transactions.export">
            <items>
                <MenuItem text="%transactions.export.view" onAction="#exportView"/>
                <MenuItem text="%transactions.export.all" onAction="#exportAll"/>
            </items>
        </MenuButton>
        <Button fx:id="editButton" text="%transactions.edit" onAction="#editSelected"/>
        <Button fx:id="deleteButton" text="%transactions.delete" onAction="#deleteSelected" styleClass="danger"/>
    </HBox>
</VBox>
